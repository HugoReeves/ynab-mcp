{
  "name": "ynab-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "docs/tool-catalog.json"
  ],
  "bin": {
    "ynab-mcp": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "check:spec": "node scripts/check-spec.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:spec",
    "generate:types": "node scripts/generate-types.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.10.1",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
