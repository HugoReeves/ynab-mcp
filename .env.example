# Runtime configuration for ynab-mcp 0.1.0. Never put real credentials here.
# The server does not automatically load .env. scripts/run-local.sh explicitly
# loads the repo's private .env using Node --env-file; existing env values win.
# Supply exactly one token source. Token files must be absolute, owned by you,
# readable, not symlinks, and private on Unix (for example chmod 600).
# YNAB_ACCESS_TOKEN=replace-locally-with-your-personal-access-token
# YNAB_ACCESS_TOKEN_FILE=/absolute/private/path/ynab-token

# Optional explicit default and local allowlist. UUIDs come from ynab_list_plans.
# Without a default, scoped calls must supply plan_id. No last-used aliases.
# YNAB_PLAN_ID=11111111-1111-4111-8111-111111111111
# YNAB_ALLOWED_PLAN_IDS=11111111-1111-4111-8111-111111111111

# Default: 15 core read tools. Extended read-only exposes 17 read tools.
# All 35 need extended + read-only=false + deletes=true + imports=true.
# Mutation previews are unavailable in read-only mode. Inspect previews and
# obtain fresh revisions before live updates/deletes. Never retry unknown writes.
YNAB_READ_ONLY=true
YNAB_ALLOW_DELETES=false
YNAB_ALLOW_RECONCILED_CHANGES=false
YNAB_ALLOW_IMPORTS=false
YNAB_TOOL_PROFILE=core
YNAB_TIMEOUT_MS=20000
YNAB_CACHE_TTL_SECONDS=30
YNAB_LOG_LEVEL=warn
